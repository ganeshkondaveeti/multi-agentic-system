# ==============================================================================
# Groww Multi-Agent Support Reply System - Environment Configuration Template
# ==============================================================================

# --- Groq API Configuration ---
# Required for live LLM classification in Facts, Pattern, and Compliance agents.
# Obtain an API key from: https://console.groq.com/keys
# If left blank or unset, agents fallback gracefully to deterministic cue tables.
GROQ_API_KEY=

# Optional model override for Groq. Default: openai/gpt-oss-120b
# Other supported models: openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Gemini API Configuration ---
# Required for live review scans (advice and performance checks) in the Reviewer node.
# Obtain an API key from: https://aistudio.google.com/app/apikey
# If left blank or unset, the reviewer falls back to deterministic code-based checks.
GEMINI_API_KEY=

# Optional model override for Gemini. Default: gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

# --- Serving (support_reply.api) ---
# auto: use Groq/Gemini when their keys are set. off: cue tables for every request.
REPLY_DESK_MODELS=auto

# When set, every /api route except /api/health needs an X-Access-Code header.
# Leave blank locally; on Render, render.yaml generates a long random one.
ACCESS_CODE=

# Comma-separated exact origins allowed to call the API from a browser. Not needed for
# `make dev` (the Vite proxy is same-origin). `make docker-run` sets its own.
ALLOWED_ORIGINS=
# Optional regex for the Render static site's pull request preview URLs.
ALLOWED_ORIGIN_REGEX=

# Header that carries the caller's IP for the rate limit. Blank: the last X-Forwarded-For
# hop. Render sets CF-Connecting-IP; set it only behind a proxy that overwrites it.
REPLY_DESK_CLIENT_IP_HEADER=

# Where approved records and email drafts go. Blank means the repo out/.
REPLY_DESK_OUT_DIR=

# --- Approval-gated MCP (mcp-server/) ---
# After a human approve, append the record to a Google Doc and create a Gmail draft with
# no recipient. Nothing is ever sent. Off unless "on". Build the server first:
#   cd mcp-server && npm ci && npm run build && npm run auth
REPLY_DESK_MCP=off
# The id in the Doc's URL: docs.google.com/document/d/<id>/edit
REPLY_DESK_DOC_ID=
# Comma-separated address(es) the Gmail draft is addressed to, such as a support inbox.
# Blank: the draft has no recipient. It is a draft either way; a person sends it.
REPLY_DESK_DRAFT_TO=
# The Google OAuth client (Desktop app) with the gmail.compose and documents scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Locally the token is mcp-server/data/google-token.json (from `npm run auth`). On Render,
# put that file's JSON here instead.
GOOGLE_TOKEN_JSON=

# Label shown in the web header and by /api/health.
REPLY_DESK_ENV=local
LOG_LEVEL=INFO
