# Copy to .env.local. Vite inlines VITE_ variables at build time.

# Empty in development: the Vite dev server and `vite preview` proxy /api to the
# local API. Set it to the API's origin for a build that calls it directly, for
# example http://localhost:8000 (`make preview-direct`) or the Railway URL.
VITE_API_BASE_URL=

# The proxy target is VITE_DEV_API_TARGET (default http://127.0.0.1:8000). vite.config.ts
# reads it from the shell, not from this file.
